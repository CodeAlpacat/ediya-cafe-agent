# 이 파일을 .env로 복사해서 사용한다:  cp .env.example .env

# LLM 모델 (Ollama 태그)
OLLAMA_MODEL=gemma4:e2b

# Ollama 엔드포인트
# - 기본 구성(권장, 호스트 GPU 사용): http://host.docker.internal:11434/v1
# - 풀-Docker 구성(docker-compose.bundled.yml)은 자동으로 http://ollama:11434/v1 로 덮어쓴다
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# 카페 프로필 — app/cafes/<이름>/ 폴더 이름. 메뉴/프롬프트/줄임말이 카페별로 분리돼 있다.
# 다른 카페를 쓰려면 폴더를 추가하고 이 값을 바꾼다.
CAFE_PROFILE=ediya
